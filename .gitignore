checkpoints/base/

# Generated artefacts.
# Large / heavy outputs (model checkpoints, raw logs, .txt debug dumps)
# stay out of git. Small audit-evidence JSONs are allow-listed below so
# anyone cloning the repo can verify public datasets without exposing
# private benchmark traces.
artifacts/logs/
artifacts/model/
artifacts/checkpoints/
# Per-run fine-tune output (model.safetensors weights ~2.7GB each).
# These are reproducible from the public dataset + manifest hash; the
# weights themselves stay out of git history to keep the repo lean.
artifacts/finetune-*/
# v3 student/teacher artefacts (LoRA adapters, predictions, training
# metrics) live in the non-public audit records.
artifacts/v3/
artifacts/*.txt
artifacts/**/*.txt
artifacts/*.json
artifacts/**/*.json
artifacts/metrics/benchmark_triage*.json
artifacts/metrics/failure_mining*.json
artifacts/metrics/realworld*.json
!artifacts/manifest/*.json
!artifacts/metrics/README.md
!artifacts/metrics/benchmark_summary.json
!artifacts/metrics/curation_report.json
!artifacts/metrics/provenance_report.json
!artifacts/metrics/provenance_v2_13_*.json
!artifacts/metrics/samples_provenance_report.json
!artifacts/metrics/archive/
!artifacts/metrics/archive/*.json
!artifacts/metrics/archive/README.md

# Non-public release artefacts. These files are intentionally untracked:
#   - regex_pii_postpass.py  (calibration layer)
#   - benchmark_teacher.py   (full prompt with few-shot examples)
#   - ec2_v3_benchmark.sh    (benchmark launcher)
#   - iam_ssm_teacher_policy.json  (IAM/account-specific policy)
scripts/v3/regex_pii_postpass.py
scripts/v3/benchmark_teacher.py
scripts/aws/ec2_v3_benchmark.sh
scripts/aws/iam_ssm_teacher_policy.json

# Proprietary 200-case OOD test set — not part of public release.
# This includes the JSONL artefact AND the Python source modules
# that produce it (cases_batch1.py..cases_batch5.py + the builder).
data/realworld_benchmark/cases.jsonl
scripts/realworld_benchmark/
scripts/build_realworld_benchmark.py

# Personal AWS billing correspondence (account ID, name, billing details).
# Archived outside the repo; pattern kept here as a safety net.
aws_*.txt

# Benchmark per-case traces (synthetic data, but verbose per-case rows).
# Aggregate .md / .html reports are kept; raw .json / .csv stay local and
# are fully reproducible by re-running the benchmark harness.
artifacts/metrics/benchmark_3way_opf*.csv
artifacts/metrics/benchmark_opf_all*.csv

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code per-user settings (entire folder — also covers
# scheduled_tasks.lock, transcripts, session state).
.claude/
.playwright-mcp/

# Controller-private records.
# Operational identifiers (AWS account ID, S3 bucket name, IAM user/role
# names, instance IDs, spot-request IDs), the provider-side filled
# Article 30 ROPA, and any DPIA detail that is not appropriate for a
# public repository live under private/. Only maintainer audit records is
# tracked, as a stub explaining the directory structure for forks /
# reproductions.
private/*
!maintainer audit records
.hf-cache-docker/

