# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Data artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*

# Archived datasets (pre-Meltemi Codex/Gemini data, quarantined, DO NOT reuse)
data/archive_*/

# Environment and secrets
.env
.env.*

# External model/runtime assets
external/
checkpoints/base/

# Generated artefacts.
# Large / heavy outputs (model checkpoints, raw logs, .txt debug dumps)
# stay out of git. Small audit-evidence JSONs (manifests + metrics
# reports) ARE committed so anyone cloning the repo can verify a
# downloaded dataset without running the full pipeline.
artifacts/logs/
artifacts/model/
artifacts/checkpoints/
# Per-run fine-tune output (model.safetensors weights ~2.7GB each).
# These are reproducible from the public dataset + manifest hash; the
# weights themselves stay out of git history to keep the repo lean.
artifacts/finetune-*/
# v3 student/teacher artefacts (LoRA adapters, predictions, training
# metrics) live in the non-public audit records.
artifacts/v3/
artifacts/*.txt
artifacts/**/*.txt
artifacts/*.json
!artifacts/manifest/*.json
!artifacts/metrics/*.json

# Proprietary v3 commercial moat — kept in the non-public audit records
# `non-public release records`. These files are intentionally
# untracked here:
#   - regex_pii_postpass.py  (non-public calibration layer)
#   - benchmark_teacher.py   (full prompt με few-shot examples)
#   - aggregate_tier_evaluation     (per-tier benchmark harness)
#   - ec2_v3_benchmark.sh    (benchmark launcher)
#   - iam_ssm_teacher_policy.json  (IAM with account ID)
scripts/v3/regex_pii_postpass.py
scripts/v3/benchmark_teacher.py
aggregate tier evaluation
scripts/aws/ec2_v3_benchmark.sh
scripts/aws/iam_ssm_teacher_policy.json

# Proprietary OOD test set — not part of public release.
data/realworld_benchmark/cases.jsonl

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code per-user settings (entire folder — also covers
# scheduled_tasks.lock, transcripts, session state).
.claude/
.playwright-mcp/

# Controller-private records.
# Operational identifiers (AWS account ID, S3 bucket name, IAM user/role
# names, instance IDs, spot-request IDs), the provider-side filled
# Article 30 ROPA, and any DPIA detail that is not appropriate for a
# public repository live under private/. Only maintainer audit records is
# tracked, as a stub explaining the directory structure for forks /
# reproductions.
private/*
!maintainer audit records
